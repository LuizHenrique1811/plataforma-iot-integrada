# Copie para .env e preencha. O .env não vai para o repositório.

# Interface em que as portas são publicadas. Use 0.0.0.0 para aceitar dispositivos de outras máquinas da rede.
BIND_ADDR=127.0.0.1

# Identificador do nó de borda; aparece no campo "via" das mensagens sincronizadas.
BORDA_ID=borda-fazenda-boa-vista

# Chave do administrador da API local da borda (cadastro e regras locais).
CHAVE_ADMIN=

# Chave de API de papel no_borda emitida pela central (POST /api/v1/chaves na central).
# Sem ela, a borda funciona e acumula a fila, mas não sincroniza.
CHAVE_CENTRAL=

# Arquivo, na máquina hospedeira, com a chave da fila cifrada. Fica fora do volume de dados da borda,
# simulando uma mídia separada (ADR-0014). A pasta segredos/ não vai para o repositório.
CHAVE_FILA_ARQUIVO=./segredos/chave-fila
