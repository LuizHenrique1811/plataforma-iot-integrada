# Copie para .env e preencha. O .env não vai para o repositório.

# Interface em que as portas são publicadas. Use 0.0.0.0 para aceitar dispositivos de outras máquinas da rede.
BIND_ADDR=127.0.0.1

POSTGRES_USER=iot
POSTGRES_PASSWORD=
POSTGRES_DB=iot

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Chave de API do administrador da plataforma (cria inquilinos e chaves). Use um valor longo e aleatório.
CHAVE_ADMIN=
